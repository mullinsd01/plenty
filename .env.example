# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection. The role needs CREATEROLE (to create the restricted
# `plenty_app` runtime role used for row-level security) on first migration.
DATABASE_URL=postgres://plenty:plenty@localhost:5432/plenty

# Public base URL of the app (used in password-reset and invite links).
APP_URL=http://localhost:3000

# ─── AI (optional) ───────────────────────────────────────────────────────────
# With a key, Plenty uses Claude to read receipts and to write new recipes.
# Without one, Plenty uses on-device OCR (Tesseract) and its built-in recipe
# library. Everything still works either way.
ANTHROPIC_API_KEY=
# auto | local | anthropic
AI_PROVIDER=auto
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Email (optional) ────────────────────────────────────────────────────────
# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465
# Without it, emails (password resets, invites) are written to the dev outbox
# at /dev/outbox (disabled in production).
SMTP_URL=
EMAIL_FROM="Plenty <hello@plenty.local>"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where receipt photos are stored (relative to the project root).
STORAGE_DIR=.data/uploads

# ─── Jobs ────────────────────────────────────────────────────────────────────
# Shared secret for the scheduled notifications endpoint:
#   curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/notifications
CRON_SECRET=change-me

# ─── Demo ────────────────────────────────────────────────────────────────────
# Shows "Explore the demo household" on the sign-in page.
DEMO_MODE=true
