# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection. The role needs CREATEROLE (to create the restricted
# `plenty_app` runtime role used for row-level security) on first migration.
DATABASE_URL=postgres://plenty:plenty@localhost:5432/plenty

# Public base URL of the app (used in password-reset and invite links).
APP_URL=http://localhost:3000

# ─── AI (optional) ───────────────────────────────────────────────────────────
# With a key, Plenty uses Claude to read receipts and to write new recipes.
# Without one, Plenty uses on-device OCR (Tesseract) and its built-in recipe
# library. Everything still works either way.
ANTHROPIC_API_KEY=
# auto | local | anthropic
AI_PROVIDER=auto
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Email (optional) ────────────────────────────────────────────────────────
# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465
# Without it, emails (password resets, invites) are written to the dev outbox
# at /dev/outbox (disabled in production).
SMTP_URL=
EMAIL_FROM="Plenty <hello@plenty.local>"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where receipt photos are stored (relative to the project root).
STORAGE_DIR=.data/uploads

# ─── Jobs ────────────────────────────────────────────────────────────────────
# Shared secret for the scheduled notifications endpoint:
#   curl -H "Authorization: Bearer $CRON_SECRET" $APP_URL/api/cron/notifications
CRON_SECRET=change-me

# Number of reverse proxies in front of Plenty that append to X-Forwarded-For.
# The client IP for rate limiting is read that many entries from the right.
TRUSTED_PROXY_HOPS=1

# ─── Billing (all optional) ──────────────────────────────────────────────────
# Plenty only offers a way of paying that is fully configured here. With none of
# this set, everything works on the free plan and no paid option is shown.
# Setup steps for each provider: docs/billing.md

# 32+ random characters. Makes the per-household token that tags store purchases
# unforgeable (needed for App Store / Google Play purchases to find their household).
# Generate one with: openssl rand -base64 48
BILLING_ACCOUNT_SECRET=

# Web subscriptions (Stripe Checkout + billing portal).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids, written plan.period=price_id (plans: plus, family; periods: monthly, annual)
STRIPE_PRICES=

# App Store (App Store Server Notifications V2 + restore). APPLE_ROOT_CERTS is a
# comma-separated list of paths to Apple's root certificates (or base64 DER).
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ROOT_CERTS=
# Optional: override product ids (defaults: app.plenty.<plan>.<period>)
APPLE_PRODUCTS=

# Google Play (real-time developer notifications via Pub/Sub push + restore).
GOOGLE_PLAY_PACKAGE_NAME=
# Service account key as JSON, or base64 of the JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# The service account the Pub/Sub push subscription signs its token as.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Optional: the push endpoint URL (default: APP_URL + /api/billing/webhooks/google)
GOOGLE_PUBSUB_AUDIENCE=
# Optional: override product ids (defaults: app.plenty.<plan>.<period>)
GOOGLE_PRODUCTS=

# ─── Demo ────────────────────────────────────────────────────────────────────
# Shows "Explore the demo household" on the sign-in page.
DEMO_MODE=true

# ─── Legal, support and analytics (optional) ─────────────────────────────────
# Named on the public /privacy, /terms and /support pages. Plenty never invents
# these: leave one unset and that line is simply left out (in development the
# pages show a "[set LEGAL_ENTITY_NAME]" placeholder so you notice).
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
# Where privacy requests go; defaults to SUPPORT_EMAIL.
PRIVACY_CONTACT_EMAIL=
# Keys the pseudonymous household id in first-party analytics (16+ characters,
# e.g. `openssl rand -hex 24`). In production, analytics records nothing until set.
ANALYTICS_SECRET=
