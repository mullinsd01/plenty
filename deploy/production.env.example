# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE production settings for Plenty. Copy this file to production.env (anywhere outside the repository, or at
# least never commit it), fill in every line marked REQUIRED, and delete the lines you don't use.
#
#   docker compose --env-file production.env -f docker-compose.prod.yml up -d      # compose reads it
#   fly secrets import < production.env                                             # Fly (secrets only; see fly.example.toml)
#   docker run --rm --env-file production.env <image> check                         # check it
#
# Write values with NO quotes (docker run --env-file would keep them as part of the value), one per line. docs/deploy.md
# explains each setting.
# Generate random secrets with:  openssl rand -hex 24      (or -base64 48 for the 32+ character ones)
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose only (docker-compose.prod.example.yml) ────────────────────
# The domain Caddy gets a certificate for (its DNS record must already point at the server). Compose builds APP_URL from it.
PLENTY_DOMAIN=plenty.example.com
# The password of the bundled Postgres. Compose builds DATABASE_URL from it; choose it before the first start.
POSTGRES_PASSWORD=
# Optional: use an image from a registry instead of building one here.
#PLENTY_IMAGE=ghcr.io/your-account/plenty:1.0.0

# ── Required ─────────────────────────────────────────────────────────────────
# Postgres. The same database user runs the migrations and the app, and it must own the database.
# Hosted databases usually need ?sslmode=require on the end.
DATABASE_URL=postgres://plenty:CHANGE-ME@your-db-host:5432/plenty?sslmode=require

# The public https address of the site, no trailing slash. Reset-password and invite links, Stripe's return pages
# and the Google Play push audience are built from it.
APP_URL=https://plenty.example.com

# Protects /api/cron/notifications. 24+ random characters. Whatever calls the hourly job sends it.
CRON_SECRET=

# Who runs this Plenty. Printed on the public Privacy Policy, Terms and Support pages (the App Store requires them).
LEGAL_ENTITY_NAME=Example Pty Ltd
SUPPORT_EMAIL=support@example.com
# Optional: a separate address for privacy requests. Defaults to SUPPORT_EMAIL.
PRIVACY_CONTACT_EMAIL=

# Email (password reset, invitations, notification emails). Your email provider gives you the SMTP address.
# Without it people who forget their password cannot get back in.
SMTP_URL=smtps://smtp-user:smtp-password@smtp.example.com:465
# The sender must be on a domain you have verified with that provider.
EMAIL_FROM=Plenty <hello@example.com>

# ── Receipt photos ───────────────────────────────────────────────────────────
# local: the server's own disk (one server; the folder must be a volume that survives redeploys; the Docker image
#        uses /data/uploads). s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=s3
#STORAGE_DIR=/data/uploads

# For s3. Keep the bucket PRIVATE (no public access, no public URL). The key needs to put, get, list and delete in it.
S3_BUCKET=plenty-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave S3_ENDPOINT out for AWS S3 and set S3_REGION to the bucket's real region (for example ap-southeast-2).
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and S3_REGION=auto
# Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com and S3_REGION=<region>
# MinIO / self-hosted: your address, and S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# ── Behind a proxy ───────────────────────────────────────────────────────────
# How many proxies sit between the visitor and Plenty and add to X-Forwarded-For (used to rate-limit sign-ins).
# 1 for Fly.io, Render, Railway or Caddy/nginx alone in front. 2 if Cloudflare is in front of one of those.
TRUSTED_PROXY_HOPS=1

# ── App Review ───────────────────────────────────────────────────────────────
# Shows "Explore the demo household" on the sign-in page. Apple's reviewers need it. Seed it with:  <image> seed
# The demo account is shared and public by design: never put real data in it.
DEMO_MODE=true

# ── Analytics (optional) ─────────────────────────────────────────────────────
# 16+ random characters. Without it Plenty records no analytics in production.
ANALYTICS_SECRET=

# ── Billing (all optional; each provider switches itself off until fully set) ─
# Store purchases (App Store, Google Play): 32+ random characters, and never change it afterwards.
BILLING_ACCOUNT_SECRET=

# Web checkout (Stripe). Webhook URL to register: <APP_URL>/api/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICES looks like: plus.monthly=price_xxx,plus.annual=price_xxx,family.monthly=price_xxx,family.annual=price_xxx
STRIPE_PRICES=

# App Store. Notification URL (production AND sandbox, version 2): <APP_URL>/api/billing/webhooks/apple
# APPLE_ROOT_CERTS: Apple's root certificate(s) as base64 so no file has to be mounted:
#   base64 -i AppleRootCA-G3.cer | tr -d '\n'        (comma-separate several)
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ROOT_CERTS=

# Google Play (only if you ship an Android app). Push URL: <APP_URL>/api/billing/webhooks/google
#GOOGLE_PLAY_PACKAGE_NAME=
#GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
#GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# ── AI (optional) ────────────────────────────────────────────────────────────
# With a key, Plenty can read receipts and write recipes with Claude for households that consent (Plus plans and up).
# Without one, receipts are read on the server with built-in OCR and meals come from the built-in library.
#ANTHROPIC_API_KEY=
#AI_PROVIDER=auto

# ── Container ────────────────────────────────────────────────────────────────
# Run the setup step (migrations + catalog) every time the container starts. Only for a single server; with more
# than one instance run `setup` once per release instead.
#PLENTY_SETUP_ON_START=true

# ── Never set in production ──────────────────────────────────────────────────
# PLAN_OVERRIDE gives a plan to every household for free. EMAIL_OUTBOX keeps unsent emails in the database.
