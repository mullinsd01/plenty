{
  "name": "Plenty",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Plenty",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash scripts/codespace.sh setup",
  "postStartCommand": "bash -c 'nohup npm run dev > /tmp/plenty-dev.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
